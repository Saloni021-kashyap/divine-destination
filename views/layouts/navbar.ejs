<nav class="navbar navbar-expand-lg navbar-divine fixed-top">
  <div class="container">
    <a href="/" class="navbar-brand logo-link">
      <span class="logo-text">Divine Destination</span>
    </a>

    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu" aria-controls="navbarMenu" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon-custom"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMenu">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
        <li class="nav-item">
          <a href="/" class="nav-link">Home</a>
        </li>
        <li class="nav-item">
          <a href="/listings" class="nav-link">Explore</a>
        </li>

        <% if (!currentUser) { %>
          <li class="nav-item">
            <a href="/login" class="nav-link">Login</a>
          </li>
          <li class="nav-item">
            <a href="/register" class="nav-link nav-pill nav-register">Register</a>
          </li>
        <% } else { %>
          <% if (currentUser.role === "admin") { %>
            <li class="nav-item">
              <a href="/listings/new" class="nav-link">Add Listing</a>
            </li>
          <% } else { %>
            <li class="nav-item">
              <a href="/bookings" class="nav-link">My Bookings</a>
            </li>
          <% } %>
          <li class="nav-item">
            <a href="/logout" class="nav-link nav-pill nav-logout">Logout</a>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<div class="flash-messages">
  <% if(success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <strong>Success!</strong> <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if(error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <strong>Error!</strong> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
</div>

