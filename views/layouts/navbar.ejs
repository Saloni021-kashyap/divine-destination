<nav class="navbar-divine">
  <div class="container-fluid">
    <div class="navbar-content">
      <div class="navbar-brand">
        <a href="/" class="logo-link">
          <span class="logo-icon">✈️</span>
          <span class="logo-text">Divine Destination</span>
        </a>
      </div>

      <div class="navbar-menu" id="navbarMenu">
        <a href="/" class="nav-link">Home</a>
        <a href="/listings" class="nav-link">Explore</a>

        <% if (!currentUser) { %>
          <a href="/login" class="nav-link">Login</a>
          <a href="/register" class="nav-link nav-register">Register</a>
        <% } else { %>
          <% if (currentUser.role === "admin") { %>
            <a href="/listings/new" class="nav-link">Add Listing</a>
          <% } else { %>
            <a href="/bookings" class="nav-link">My Bookings</a>
          <% } %>
          <a href="/logout" class="nav-link nav-logout">Logout</a>
        <% } %>
      </div>

      <button class="mobile-menu-toggle" id="mobileMenuToggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="navbarMenu">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>
</nav>

<div class="flash-messages">
  <% if(success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <strong>Success!</strong> <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if(error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <strong>Error!</strong> <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
</div>
