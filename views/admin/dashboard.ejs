<% layout("layouts/boilerplate") %>

<div class="container mt-5">

<h2 class="mb-4">Admin Dashboard 🚀</h2>

<div class="row">

<div class="col-md-4">
<div class="card shadow p-3">
<h5>Total Listings</h5>
<h2><%= totalListings %></h2>
</div>
</div>

<div class="col-md-4">
<div class="card shadow p-3">
<h5>Total Users</h5>
<h2><%= totalUsers %></h2>
</div>
</div>

<div class="col-md-4">
<div class="card shadow p-3">
<h5>Total Bookings</h5>
<h2><%= totalBookings %></h2>
</div>
</div>

<div class="col-md-4 mt-4">
<div class="card shadow p-3">
<h5>Manage Listings</h5>
<a href="/listings" class="btn btn-primary mt-2">
View Listings
</a>
</div>
</div>

</div>

<br>

<div class="mt-4">
<h3 class="mb-3">Recent Bookings</h3>

<% if (!bookings || bookings.length === 0) { %>
  <div class="card shadow-sm p-3">
    <p class="mb-0">No bookings found.</p>
  </div>
<% } else { %>
  <div class="row g-3">
    <% bookings.forEach(booking => { %>
      <div class="col-md-6">
        <div class="card shadow-sm p-3 h-100">
          <p class="mb-2"><strong>User:</strong> <%= booking.user && booking.user.name ? booking.user.name : "Unknown user" %></p>
          <p class="mb-2"><strong>Email:</strong> <%= booking.user && booking.user.email ? booking.user.email : "N/A" %></p>
          <p class="mb-2"><strong>Package:</strong> <%= booking.listing && booking.listing.title ? booking.listing.title : "Listing unavailable" %></p>
          <p class="mb-2"><strong>Travel Date:</strong> <%= booking.travelDate ? new Date(booking.travelDate).toDateString() : "N/A" %></p>
          <p class="mb-2"><strong>Persons:</strong> <%= booking.seats || 0 %></p>
          <p class="mb-0"><strong>Phone:</strong> <%= booking.phone || "N/A" %></p>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
</div>

<a href="/logout" class="btn btn-danger">Logout</a>

</div>
