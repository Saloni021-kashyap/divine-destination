<% layout("layouts/boilerplate") %>

<%
// Safe image data normalization
const DEFAULT_PLACEHOLDER = 'https://via.placeholder.com/800x500?text=No+Image';
const slideImages = listing.images && Array.isArray(listing.images) && listing.images.length > 0
  ? listing.images.filter(img => img && img.url)
  : [];
const hasImages = slideImages.length > 0;
const isSingleImage = slideImages.length === 1;
const isMultipleImages = slideImages.length > 1;
%>

<div class="container listing-container mt-5">
  <div class="row gy-4">

    <!-- Main Image Section -->
    <div class="col-lg-8">
      <% if (listing && listing.images && listing.images.length > 0) { %>
        <% if (listing.images.length >= 5) { %>
          <div class="image-grid">
            <!-- Main Image -->
            <div class="main-image">
              <img src="<%= listing.images[0].url %>" alt="<%= listing.title %>" />
            </div>

            <!-- Side Images -->
            <div class="side-images">
              <% listing.images.slice(1, 5).forEach(img => { %>
                <% if (img && img.url) { %>
                  <img src="<%= img.url %>" alt="<%= listing.title %>" />
                <% } %>
              <% }) %>
            </div>

            <% if (listing.images.length > 5) { %>
              <button class="show-all" onclick="document.getElementById('allPhotosModal').classList.add('show');">Show all photos</button>
            <% } %>
          </div>
        <% } else { %>
          <!-- Fallback slider for fewer than 5 images -->
          <div class="image-slider">
            <div class="slider-container">
              <% listing.images.forEach((img, index) => { %>
                <% if (img && img.url) { %>
                  <div class="slide <%= index === 0 ? 'active' : '' %>" data-index="<%= index %>">
                    <img src="<%= img.url %>" alt="<%= listing.title %>" class="slide-image" />
                  </div>
                <% } %>
              <% }) %>
            </div>

            <% if (listing.images.length > 1) { %>
              <button class="slider-arrow prev" onclick="changeSlide(-1)"><span>‹</span></button>
              <button class="slider-arrow next" onclick="changeSlide(1)"><span>›</span></button>

              <div class="slide-indicators">
                <% listing.images.forEach((_, index) => { %>
                  <button class="indicator <%= index === 0 ? 'active' : '' %>" onclick="currentSlide(<%= index %>)"></button>
                <% }) %>
              </div>

              <div class="image-counter"><span id="currentSlide">1</span> / <span id="totalSlides"><%= listing.images.length %></span></div>
            <% } %>
          </div>
        <% } %>
      <% } else { %>
        <img src="/default.jpg" class="fallback-img" alt="No Image Available" />
      <% } %>
    </div>

    <!-- Listing Details Section -->
    <div class="col-lg-4">
      <div class="listing-details-card">
        <h2 class="listing-title"><%= listing.title %></h2>
        <p class="listing-location">📍 <%= listing.location %></p>
        <p class="listing-mode"><%= listing.travelMode %> Transport</p>
        
        <div class="price-section">
          <span class="price-label">Price per person</span>
          <h3 class="price-value">₹<%= listing.price %></h3>
        </div>

        <hr class="my-4">

        <div class="description-section">
          <h5>About this listing</h5>
          <p class="listing-description"><%= listing.description || 'No description provided' %></p>
        </div>

        <div class="booking-section">
          <a href="/listings/<%= listing._id %>/book" class="btn btn-primary btn-lg w-100">Book Now</a>
          <a href="/listings" class="btn btn-outline-secondary mt-2 w-100">Back to Listings</a>
        </div>
      </div>
    </div>

  </div>

  <!-- Admin Controls -->
  <% if (currentUser && currentUser.role === "admin") { %>
    <div class="admin-controls">
      <h4>Admin Controls</h4>
      <div class="admin-buttons btn-group">
        <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn">
          Edit Listing
        </a>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
          <button class="btn delete-btn" type="submit" onclick="return confirm('Are you sure you want to delete this listing?');">
            Delete Listing
          </button>
        </form>
      </div>
    </div>
  <% } %>

</div>

<script>
// Image Slider Functionality
let currentSlideIndex = 0;
const totalSlides = <%= slideImages.length %>;

function changeSlide(n) {
  showSlide(currentSlideIndex += n);
}

function currentSlide(n) {
  showSlide(currentSlideIndex = n);
}

function showSlide(n) {
  const slides = document.querySelectorAll('.slide');
  const indicators = document.querySelectorAll('.indicator');
  
  if (n >= slides.length) {
    currentSlideIndex = 0;
  } else if (n < 0) {
    currentSlideIndex = slides.length - 1;
  }
  
  slides.forEach(slide => slide.classList.remove('active'));
  indicators.forEach(ind => ind.classList.remove('active'));
  
  if (slides[currentSlideIndex]) {
    slides[currentSlideIndex].classList.add('active');
  }
  if (indicators[currentSlideIndex]) {
    indicators[currentSlideIndex].classList.add('active');
  }
  
  document.getElementById('currentSlide').textContent = currentSlideIndex + 1;
}

// Keyboard navigation
document.addEventListener('keydown', (e) => {
  if (e.key === 'ArrowLeft') changeSlide(-1);
  if (e.key === 'ArrowRight') changeSlide(1);
});
</script>
