<% layout("layouts/boilerplate") %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="form-card listing-form-card">
        <h2 class="mb-4">Create New Travel Listing</h2>

        <form action="/listings" method="POST" enctype="multipart/form-data" id="listingForm">
          <div class="mb-3">
            <label for="title" class="form-label">Trip Title</label>
            <input type="text" id="title" name="title" class="form-control" placeholder="Amazing Beach Trip" required>
          </div>

          <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" id="location" name="location" class="form-control" placeholder="Goa, India" required>
          </div>

          <div class="mb-3">
            <label for="travelMode" class="form-label">Travel Mode</label>
            <select id="travelMode" name="travelMode" class="form-control">
              <option value="Bus">Bus</option>
              <option value="Train" selected>Train</option>
              <option value="Flight">Flight</option>
            </select>
          </div>

          <div class="mb-3">
            <label for="price" class="form-label">Price (per person)</label>
            <input type="number" id="price" name="price" class="form-control" placeholder="5000" min="0" required>
          </div>

          <div class="mb-3">
            <label for="totalSeats" class="form-label">Total Seats</label>
            <input type="number" id="totalSeats" name="totalSeats" class="form-control" value="40" min="1">
          </div>

          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea id="description" name="description" class="form-control" rows="4" placeholder="Describe your trip..."></textarea>
          </div>

          <div class="mb-3">
            <label for="images" class="form-label">Upload Images</label>
            <div class="upload-area">
              <input
                type="file"
                id="images"
                name="images"
                class="form-control image-preview-input"
                data-preview-target="imagePreview"
                multiple
                accept="image/*"
                required
              >
              <small class="form-text text-muted d-block mt-2">Upload up to 5 images. The first image will be used as the cover image.</small>
            </div>
          </div>

          <div id="imagePreview" class="image-preview-grid mb-3"></div>

          <button type="submit" class="btn btn-success btn-lg w-100">Create Listing</button>
          <a href="/listings" class="btn btn-outline-secondary btn-lg w-100 mt-2">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</div>
