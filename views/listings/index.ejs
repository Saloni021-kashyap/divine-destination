<% layout("layouts/boilerplate") %>

<section class="hero-section">
  <div class="hero-overlay"></div>
  <div class="container hero-content text-center">
    <h1 class="hero-title">Explore Divine Pilgrimage Tours Across India</h1>
    <p class="hero-subtitle">Maa Vaishno Devi Pilgrimage Travel Association offers complete travel solutions with buses, trains, flights, helicopters, and cars for spiritual journeys and family tours.</p>

    <div class="hero-info-card">
      <h2 class="hero-info-title">Maa Vaishno Devi Pilgrimage Travel Association</h2>
      <p class="hero-info-text">Comfortable and reliable pilgrimage and family tour services across India.</p>
      <p class="hero-info-meta"><strong>Contact:</strong> 7500955557, 9759857010, 6398263175</p>
      <p class="hero-info-meta mb-0"><strong>Location:</strong>Office Location Janta Road,Janta Road Arpit Vihar, Saharanpur</p>
    </div>

    <div class="hero-actions d-flex gap-3 justify-content-center flex-wrap">
      <a href="#listings" class="btn btn-primary btn-lg hero-btn">Explore Packages</a>
      <% if(currentUser && currentUser.role === "admin"){ %>
        <a href="/listings/new" class="btn btn-outline-light btn-lg hero-btn-secondary">Create Listing</a>
      <% } %>
    </div>
  </div>
</section>

<section class="search-section py-3 border-bottom sticky-search">
  <div class="container">
    <div class="row g-2 g-md-3 align-items-center">
      <div class="col-12 col-md-5">
        <input type="text" class="form-control search-input" placeholder="Search destination..." id="searchInput">
      </div>
      <div class="col-12 col-md-4">
        <select class="form-select search-input" id="priceFilter">
          <option value="">All Prices</option>
          <option value="5000">Under INR 5,000</option>
          <option value="10000">INR 5,000 - INR 10,000</option>
          <option value="20000">INR 10,000 - INR 20,000</option>
          <option value="99999">INR 20,000+</option>
        </select>
      </div>
      <div class="col-12 col-md-3">
        <button class="btn btn-primary w-100 search-btn" onclick="filterListings()">Filter Packages</button>
      </div>
    </div>
  </div>
</section>

<section id="listings" class="listings-section py-5 bg-light">
  <div class="container">
    <div class="text-center mb-4 mb-md-5">
      <h2 class="section-title fw-bold">Popular Travel Packages</h2>
      <p class="section-subtitle text-muted">Choose from our curated collection of destinations</p>
    </div>

    <% if(listings.length === 0){ %>
      <div class="text-center py-5">
        <h4 class="text-muted">No packages found</h4>
        <p class="text-muted mb-0">Check back soon for more travel packages.</p>
      </div>
    <% } else { %>
      <div class="row g-3 g-md-4" id="listingsGrid">
        <% listings.forEach(listing => { %>
          <div class="col-12 col-sm-6 col-lg-4 col-xxl-3 d-flex">
            <article class="card listing-card w-100 h-100">
              <a href="/listings/<%= listing._id %>" class="listing-card-link text-decoration-none d-flex flex-column h-100">
                <div class="listing-image-container position-relative overflow-hidden">
                  <div class="swiper listing-swiper">
                    <div class="swiper-wrapper">
                      <% const listingImages = (listing.images && Array.isArray(listing.images) && listing.images.length > 0)
                        ? listing.images
                        : (listing.image ? [listing.image] : [{ url: 'https://via.placeholder.com/400x250', filename: 'placeholder.jpg' }]); %>

                      <% listingImages.forEach(function(img) { %>
                        <% const imageUrl = (typeof img === 'string') ? img : (img && img.url) ? img.url : 'https://via.placeholder.com/400x250'; %>
                        <div class="swiper-slide">
                          <img src="<%= imageUrl %>" class="card-img-top listing-image" alt="<%= listing.title %>">
                        </div>
                      <% }); %>
                    </div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                    <div class="swiper-pagination"></div>
                  </div>
                  <div class="listing-overlay"></div>
                  <span class="badge badge-travel position-absolute top-0 end-0 m-3">
                    <% if(listing.travelMode) { %>
                      <%= listing.travelMode %>
                    <% } else { %>
                      Train
                    <% } %>
                  </span>
                </div>

                <div class="card-body d-flex flex-column">
                  <h3 class="card-title fw-bold text-dark mb-2">
                    <%= listing.title.substring(0, 40) %><% if(listing.title.length > 40) { %>...<% } %>
                  </h3>

                  <p class="card-location text-muted mb-2">
                    <%= listing.location %>
                  </p>

                  <p class="card-description text-muted mb-3">
                    <%= (listing.description || 'Great travel destination').substring(0, 80) %>...
                  </p>

                  <div class="availability-badge mb-3">
                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">
                      <% if(listing.availableSeats > 10) { %>
                        Many Seats Available
                      <% } else if(listing.availableSeats > 0) { %>
                        Few Seats Left (<%= listing.availableSeats %>)
                      <% } else { %>
                        Sold Out
                      <% } %>
                    </span>
                  </div>

                  <div class="mt-auto d-flex justify-content-between align-items-center gap-2">
                    <h4 class="text-primary fw-bold mb-0">INR <%= listing.price %></h4>
                    <small class="text-muted"><%= listing.availableSeats %>/<%= listing.totalSeats %> seats</small>
                  </div>
                </div>

                <div class="card-footer border-0 py-2 px-3 bg-white">
                  <span class="btn btn-primary w-100 fw-semibold">View Details</span>
                </div>
              </a>

              <% if (currentUser && currentUser.role === "admin") { %>
                <div class="listing-admin-actions p-3 pt-0 d-flex gap-2">
                  <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary w-100">Edit</a>
                  <form class="w-100" action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-outline-danger w-100" type="submit">Delete</button>
                  </form>
                </div>
              <% } %>
            </article>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<section class="cta-section py-5 text-white text-center">
  <div class="container">
    <h2 class="fw-bold mb-3">Ready to Start Your Journey?</h2>
    <p class="mb-4">Book your next adventure with comfortable and reliable travel packages.</p>
    <a href="#listings" class="btn btn-light btn-lg">Browse All Packages</a>
  </div>
</section>

<script>
  function filterListings() {
    const searchQuery = document.getElementById('searchInput')?.value || '';
    if(searchQuery) {
      window.location.href = `/listings/search?q=${encodeURIComponent(searchQuery)}`;
    }
  }
  document.getElementById('searchInput')?.addEventListener('keypress', (e) => {
    if(e.key === 'Enter') filterListings();
  });
</script>
