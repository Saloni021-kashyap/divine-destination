<% layout("layouts/boilerplate") %>

<!-- ============= HERO SECTION ============= -->
<section class="hero-section">
  <div class="hero-overlay"></div>
  <div class="container hero-content d-flex align-items-center justify-content-center text-center">
    <div>
      <h1 class="hero-title mb-3">🌍 Explore Divine India</h1>
      <p class="hero-subtitle mb-5">Discover unforgettable travel experiences across India's holiest destinations</p>
      <div class="d-flex gap-3 justify-content-center flex-wrap">
        <a href="#listings" class="btn btn-primary btn-lg hero-btn">Explore Packages</a>
        <% if(currentUser && currentUser.role === "admin"){ %>
          <a href="/listings/new" class="btn btn-light btn-lg hero-btn-secondary">Create Listing</a>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- ============= SEARCH & FILTER SECTION ============= -->
<section class="search-section py-4 bg-white border-bottom sticky-search">
  <div class="container">
    <div class="row g-3">
      <div class="col-md-4">
        <input type="text" class="form-control search-input" placeholder="Search destination..." id="searchInput">
      </div>
      <div class="col-md-4">
        <select class="form-select search-input" id="priceFilter">
          <option value="">All Prices</option>
          <option value="5000">Under ₹5,000</option>
          <option value="10000">₹5,000 - ₹10,000</option>
          <option value="20000">₹10,000 - ₹20,000</option>
          <option value="99999">₹20,000+</option>
        </select>
      </div>
      <div class="col-md-4">
        <button class="btn btn-primary w-100 search-btn" onclick="filterListings()">🔍 Filter Packages</button>
      </div>
    </div>
  </div>
</section>

<!-- ============= LISTINGS SECTION ============= -->
<section id="listings" class="listings-section py-5 bg-light">
  <div class="container">
    <!-- Section Header -->
    <div class="text-center mb-5">
      <h2 class="section-title fw-bold">Popular Travel Packages</h2>
      <p class="section-subtitle text-muted">Choose from our curated collection of amazing destinations</p>
    </div>

    <!-- Listings Grid -->
    <% if(listings.length === 0){ %>
      <div class="text-center py-5">
        <h4 class="text-muted">No packages found 😔</h4>
        <p class="text-muted mb-4">Check back soon for more travel packages!</p>
      </div>
    <% } else { %>
      <div class="row g-4" id="listingsGrid">
        <% listings.forEach(listing => { %>
          <div class="col-lg-4 col-md-6 col-sm-12">
            <div class="card listing-card h-100">
              <a href="/listings/<%= listing._id %>" class="listing-card-link text-decoration-none">
                <!-- Image Container -->
                <div class="listing-image-container position-relative overflow-hidden">
                  <div class="swiper listing-swiper">
                    <div class="swiper-wrapper">
                      <% const listingImages = (listing.images && Array.isArray(listing.images) && listing.images.length > 0)
                        ? listing.images
                        : (listing.image ? [listing.image] : [{ url: 'https://via.placeholder.com/400x250', filename: 'placeholder.jpg' }]); %>

                      <% listingImages.forEach(function(img) { %>
                        <% const imageUrl = (typeof img === 'string') ? img : (img && img.url) ? img.url : 'https://via.placeholder.com/400x250'; %>
                        <div class="swiper-slide">
                          <img src="<%= imageUrl %>" class="card-img-top listing-image" alt="<%= listing.title %>">
                        </div>
                      <% }); %>
                    </div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                    <div class="swiper-pagination"></div>
                  </div>
                  <div class="listing-overlay"></div>
                  <span class="badge badge-travel position-absolute top-3 end-3">
                    <% if(listing.travelMode) { %>
                      <% if(listing.travelMode === 'Bus') { %>🚌<% } else if(listing.travelMode === 'Train') { %>🚆<% } else if(listing.travelMode === 'Flight') { %>✈️<% } %>
                      <%= listing.travelMode %>
                    <% } else { %>🚆 Train<% } %>
                  </span>
                </div>

                <!-- Card Body -->
                <div class="card-body d-flex flex-column">
                  <!-- Title -->
                  <h5 class="card-title fw-bold text-dark mb-2">
                    <%= listing.title.substring(0, 40) %><% if(listing.title.length > 40) { %>...<% } %>
                  </h5>

                  <!-- Location -->
                  <p class="card-location text-muted mb-2" style="font-size: 14px;">
                    📍 <%= listing.location %>
                  </p>

                  <!-- Description Preview -->
                  <p class="card-description text-muted mb-3" style="font-size: 13px;">
                    <%= (listing.description || 'Great travel destination').substring(0, 60) %>...
                  </p>

                  <!-- Availability -->
                  <div class="availability-badge mb-3">
                    <span class="badge bg-success">
                      <% if(listing.availableSeats > 10) { %>
                        ✅ Many Seats Available
                      <% } else if(listing.availableSeats > 0) { %>
                        ⚠️ Few Seats Left (<%= listing.availableSeats %>)
                      <% } else { %>
                        ❌ Sold Out
                      <% } %>
                    </span>
                  </div>

                  <!-- Price & Seats (flex-grow to push to bottom) -->
                  <div class="mt-auto">
                    <div class="d-flex justify-content-between align-items-center">
                      <h4 class="text-primary fw-bold mb-0">₹<%= listing.price %></h4>
                      <small class="text-muted"><%= listing.availableSeats %>/<%= listing.totalSeats %> seats</small>
                    </div>
                  </div>
                </div>

                <!-- Card Footer CTA -->
                <div class="card-footer bg-primary rounded-bottom-3 border-0 py-2">
                  <button class="btn btn-sm btn-light w-100 fw-bold" style="font-size: 14px;">
                    View Details ➜
                  </button>
                </div>
              </a>
              <% if (currentUser && currentUser.role === "admin") { %>
                <div class="listing-admin-actions">
                  <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn">Edit</a>
                  <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                    <button class="btn delete-btn" type="submit">Delete</button>
                  </form>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<!-- ============= CTA SECTION ============= -->
<section class="cta-section py-5 bg-primary text-white text-center">
  <div class="container">
    <h2 class="fw-bold mb-3">Ready to Start Your Journey? 🎒</h2>
    <p class="mb-4" style="font-size: 16px;">
      Don't miss out on amazing travel experiences. Book your next adventure today!
    </p>
    <a href="#listings" class="btn btn-light btn-lg">Browse All Packages</a>
  </div>
</section>

<script>
  function filterListings() {
    const searchQuery = document.getElementById('searchInput')?.value || '';
    if(searchQuery) {
      window.location.href = `/listings/search?q=${encodeURIComponent(searchQuery)}`;
    }
  }
  document.getElementById('searchInput')?.addEventListener('keypress', (e) => {
    if(e.key === 'Enter') filterListings();
  });
</script>
