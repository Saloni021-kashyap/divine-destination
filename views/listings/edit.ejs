<% layout("layouts/boilerplate") %>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="form-card listing-form-card">
        <h2 class="mb-4">Edit Travel Listing</h2>

        <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" enctype="multipart/form-data" id="editForm">
          <div class="mb-3">
            <label for="title" class="form-label">Trip Title</label>
            <input type="text" id="title" name="title" value="<%= listing.title %>" class="form-control" required>
          </div>

          <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" id="location" name="location" value="<%= listing.location %>" class="form-control" required>
          </div>

          <div class="mb-3">
            <label for="travelMode" class="form-label">Travel Mode</label>
            <select id="travelMode" name="travelMode" class="form-control">
              <option value="Bus" <%= listing.travelMode === "Bus" ? "selected" : "" %>>Bus</option>
              <option value="Train" <%= listing.travelMode === "Train" ? "selected" : "" %>>Train</option>
              <option value="Flight" <%= listing.travelMode === "Flight" ? "selected" : "" %>>Flight</option>
            </select>
          </div>

          <div class="mb-3">
            <label for="price" class="form-label">Price (per person)</label>
            <input type="number" id="price" name="price" value="<%= listing.price %>" class="form-control" min="0" required>
          </div>

          <div class="mb-3">
            <label for="totalSeats" class="form-label">Total Seats</label>
            <input type="number" id="totalSeats" name="totalSeats" value="<%= listing.totalSeats %>" class="form-control" min="1">
          </div>

          <div class="alert alert-info">
            <strong>Available Seats:</strong> <%= listing.availableSeats || listing.totalSeats %>
          </div>

          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea id="description" name="description" class="form-control" rows="4"><%= listing.description || "" %></textarea>
          </div>

          <% if (listing.images && listing.images.length > 0) { %>
            <div class="mb-4">
              <h5 class="mb-3">Current Images (<%= listing.images.length %>)</h5>
              <div id="currentImagesPreview" class="current-images-grid">
                <% listing.images.forEach((img, index) => { %>
                  <div class="current-image-item">
                    <img src="<%= img.url || img %>" alt="Listing image <%= index + 1 %>" class="current-image">
                    <div class="image-info"><%= img.filename || "uploaded.jpg" %></div>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

          <div class="mb-3">
            <label for="newImages" class="form-label">Add More Images (Optional)</label>
            <div class="upload-area">
              <input
                type="file"
                id="newImages"
                name="images"
                class="form-control image-preview-input"
                data-preview-target="newImagePreview"
                multiple
                accept="image/*"
              >
              <small class="form-text text-muted d-block mt-2">Upload additional images or leave empty to keep current images.</small>
            </div>
          </div>

          <div id="newImagePreview" class="image-preview-grid mb-4"></div>

          <div class="btn-group-vertical w-100">
            <button type="submit" class="btn btn-primary btn-lg">Update Listing</button>
            <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary btn-lg mt-2">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
